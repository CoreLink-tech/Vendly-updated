# Supabase (database + legacy image storage for anything uploaded before the R2 migration)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (image storage — product photos, vendor logos)
# R2_ACCOUNT_ID: found on the R2 dashboard overview page in Cloudflare
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: generated when creating an R2 API token
# R2_BUCKET_NAME: the bucket you created (e.g. vendly-images)
# R2_PUBLIC_URL: the bucket's public URL — either the free *.r2.dev one,
#   or a custom domain if you've connected one. No trailing slash.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Admin
ADMIN_SETUP_SECRET=

# Cron (Vercel Cron sends this as a Bearer token — set to a random string)
CRON_SECRET=
